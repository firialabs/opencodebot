@@ -0,0 +1,18 @@
+# Stand-in for the CB3 botcore: sensors and motors live in the JS world sim.
+import js
+_w = js.world
+
+class _Motors:
+    def run(self, which, pct):
+        _w.setMotor(which, pct)
+    def enable(self, on):
+        _w.enableMotors(bool(on))
+
+class _LS:
+    def read(self, n):
+        return _w.lineSensor(n)
+
+motors = _Motors()
+ls = _LS()
+LEFT = 0
+RIGHT = 1
