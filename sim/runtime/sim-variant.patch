diff --git a/ports/webassembly/variants/sim/mpconfigvariant.mk b/ports/webassembly/variants/sim/mpconfigvariant.mk
new file mode 100644
index 0000000..f1e02d3
--- /dev/null
+++ b/ports/webassembly/variants/sim/mpconfigvariant.mk
@@ -0,0 +1,10 @@
+# Robot simulator variant: the browser (JSPI) variant plus a VM hook that
+# charges simulated time and can suspend to the JS event loop, a sleep that
+# advances simulated time, and frozen device modules.
+FROZEN_MANIFEST ?= variants/sim/manifest.py
+SUPPORT_LONGJMP = wasm
+JSFLAGS += -s JSPI
+JSFLAGS += -s JSPI_EXPORTS=mp_js_do_exec_async,proxy_c_to_js_resume,mp_js_repl_process_char_async
+JSFLAGS += -s ALLOW_MEMORY_GROWTH
+EXPORTED_FUNCTIONS_EXTRA += ,_sim_set_hook_period
+SRC_C += variants/sim/simhook.c
diff --git a/ports/webassembly/variants/sim/simhook.c b/ports/webassembly/variants/sim/simhook.c
new file mode 100644
index 0000000..983dd29
--- /dev/null
+++ b/ports/webassembly/variants/sim/simhook.c
@@ -0,0 +1,57 @@
+// Simulator hooks: simulated time for tight loops and for sleep, with a
+// JSPI suspension to the JS event loop so the worker can take messages
+// (pause, step, stop) while Python is running.
+#include <emscripten.h>
+#include "py/runtime.h"
+#include "py/mphal.h"
+
+bool mp_js_can_suspend(void);
+void mp_js_suspension_begin(void);
+void mp_js_suspension_end(void);
+
+unsigned int sim_hook_count = 0;
+unsigned int sim_hook_period = 0xffffffffu; // off until JS sets it
+
+void sim_set_hook_period(unsigned int n) {
+    sim_hook_period = n ? n : 0xffffffffu;
+    sim_hook_count = 0;
+}
+
+// Charge "n" branches of simulated time; nonzero asks to yield.
+EM_JS(int, sim_js_charge, (unsigned int n), {
+    return Module.simCharge ? Module.simCharge(n) : 0;
+});
+
+// Yield to the event loop (and wait there while paused).
+EM_ASYNC_JS(void, sim_js_yield, (void), {
+    if (Module.simYield) { await Module.simYield(); }
+});
+
+// Advance simulated time by ms, then pace against the wall clock.
+EM_ASYNC_JS(void, sim_js_sleep, (unsigned int ms), {
+    if (Module.simSleep) { await Module.simSleep(ms); }
+});
+
+
+void sim_vm_hook(void) {
+    unsigned int n = sim_hook_count;
+    sim_hook_count = 0;
+    if (sim_js_charge(n) && mp_js_can_suspend()) {
+        mp_js_suspension_begin();
+        sim_js_yield();
+        mp_js_suspension_end();
+    }
+}
+
+void sim_delay_ms(mp_uint_t ms) {
+    if (mp_js_can_suspend()) {
+        mp_js_suspension_begin();
+        sim_js_sleep(ms);
+        mp_js_suspension_end();
+    } else {
+        // No suspender (e.g. a synchronous runPython): just advance time.
+        sim_js_charge(0);
+    }
+    // A stop requested while suspended is a pending KeyboardInterrupt.
+    mp_handle_pending(true);
+}
