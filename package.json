{
  "name": "opencodebot",
  "version": "0.1.0",
  "private": false,
  "license": "MIT",
  "description": "A light, friendly, block-based coding playground for Firia Labs CodeBot, CodeX, and CodeAIR.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "npm run sim:assets && vite build",
    "preview": "vite preview",
    "test": "node tests/protocol.mjs && node tests/smoke.mjs && node tests/subpath.mjs && node tests/sim.mjs && node tests/sim-ui.mjs",
    "test:protocol": "node tests/protocol.mjs",
    "test:ui": "node tests/smoke.mjs",
    "test:subpath": "node tests/subpath.mjs",
    "test:sim": "node tests/sim.mjs && node tests/sim-ui.mjs",
    "sim:assets": "node sim/tools/build-env.mjs gym && node sim/tools/build-models.mjs",
    "sim:runtime": "sim/runtime/build.sh"
  },
  "dependencies": {
    "@fontsource-variable/fredoka": "^5.3.0",
    "@fontsource-variable/nunito": "^5.3.0",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "blockly": "^13.3.0",
    "three": "^0.181.0"
  },
  "devDependencies": {
    "@gltf-transform/core": "^4.5.1",
    "@gltf-transform/extensions": "^4.5.1",
    "@gltf-transform/functions": "^4.5.1",
    "draco3dgltf": "^1.5.9",
    "meshoptimizer": "^1.3.0",
    "playwright": "^1.56.1",
    "sharp": "^0.35.5",
    "vite": "^8.3.0",
    "vite-plugin-pwa": "^1.3.0"
  },
  "engines": {
    "node": ">=24"
  }
}
